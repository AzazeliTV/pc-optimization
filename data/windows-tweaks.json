{
  "version": "2.0.0",
  "lastUpdated": "2026-01-30",
  "windowsVersion": "Windows 11 24H2",
  "sections": [
    {
      "id": "vbs",
      "title": "VBS/Memory Integrity deaktivieren",
      "icon": "shield-off",
      "impact": "5-15% mehr FPS",
      "critical": true,
      "description": "Virtualization-Based Security kostet erheblich Performance beim Gaming.",
      "warning": "Windows 11 24H2 Update: VBS ist komplexer zu deaktivieren geworden. Es gibt jetzt eine zusätzliche Windows Hello VBS-Abhängigkeit die auch deaktiviert werden muss!",
      "steps": [
        {
          "title": "Memory Integrity deaktivieren",
          "type": "gui",
          "instructions": [
            "Einstellungen → Datenschutz & Sicherheit → Windows-Sicherheit",
            "Gerätesicherheit → Kernisolierung → Details",
            "Speicherintegrität → AUS"
          ]
        },
        {
          "title": "Tamper Protection deaktivieren",
          "type": "gui",
          "note": "Für Registry-Änderungen nötig",
          "instructions": [
            "Windows-Sicherheit → Viren- & Bedrohungsschutz",
            "Einstellungen verwalten → Manipulationsschutz → AUS"
          ]
        },
        {
          "title": "VBS via Registry deaktivieren",
          "type": "cmd",
          "adminRequired": true,
          "command": "reg add \"HKEY_LOCAL_MACHINE\\SYSTEM\\CurrentControlSet\\Control\\DeviceGuard\" /v EnableVirtualizationBasedSecurity /t REG_DWORD /d 0 /f"
        },
        {
          "title": "Windows Hello VBS deaktivieren (NEU für 24H2!)",
          "type": "cmd",
          "adminRequired": true,
          "command": "reg add \"HKEY_LOCAL_MACHINE\\SYSTEM\\CurrentControlSet\\Control\\DeviceGuard\\Scenarios\\WindowsHello\" /v Enabled /t REG_DWORD /d 0 /f"
        },
        {
          "title": "Hypervisor deaktivieren",
          "type": "cmd",
          "adminRequired": true,
          "command": "bcdedit /set hypervisorlaunchtype off"
        }
      ],
      "verification": {
        "command": "msinfo32",
        "expected": "Virtualization-based security = Not enabled"
      },
      "note": "Das Deaktivieren von VBS kann Windows Hello Face Recognition beeinträchtigen. PIN-Login funktioniert weiterhin."
    },
    {
